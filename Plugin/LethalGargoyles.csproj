<Project Sdk="Microsoft.NET.Sdk">

    <!-- BepInEx Properties -->
    <PropertyGroup>
        <AssemblyName>DropDaDeuce.LethalGargoyles</AssemblyName>
        <Product>LethalGargoyles</Product>
        <!-- Change to whatever version you're currently on. -->
        <Version>0.7.0</Version>
    </PropertyGroup>

  <!-- Thunderstore CLI stuff -->
  <PropertyGroup>
    <!-- Your Thunderstore Team name. This will be used by tcli when building our Thunderstore package. -->
    <ThunderstoreTeam>DropDaDeuce</ThunderstoreTeam>
    <!-- Configure description for Thunderstore at ./Thunderstore/thunderstore.toml -->
  </PropertyGroup>

    <!-- Project Properties -->
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>LethalGargoyles</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- Enable Nullable for better IDE null-checking -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
      NVorbis version, declared ONCE. The PackageReference below and the CopyNVorbis target at the
      bottom both read it, so the restored package and the copied DLL can never drift apart.
    -->
    <PropertyGroup>
        <NVorbisVersion>0.10.5</NVorbisVersion>
    </PropertyGroup>

    <!-- Set NuGet Sources -->
    <PropertyGroup>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <!-- Embed Debug Symbols for Easier Debugging -->
    <PropertyGroup>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>embedded</DebugType>
        <!--
        Trim the project path to prevent players from potentially
        viewing Private Information in stack traces.
        -->
        <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
    </PropertyGroup>

    <!-- Primary Package References -->
    <ItemGroup>
      <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
      <PackageReference Include="BepInEx.Core" Version="5.*" />
      <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
      <PackageReference Include="NVorbis" Version="$(NVorbisVersion)" />
      <PackageReference Include="UnityEngine.Modules" Version="2022.3.9" IncludeAssets="compile" />
      <PackageReference Include="Evaisa.LethalLib" Version="0.*" />
      
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
      <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

    <!--
      References - Game Assemblies.
      All four resolve through $(ManagedDirectory), which LethalGargoyles.csproj.user derives from
      the machine's own $(GameDirectory). Do NOT reintroduce a literal path here: Unity.Collections
      and Unity.Mathematics used to be referenced by a relative walk up to Program Files, which
      depended on how deep the repo happened to sit on disk and broke on any other machine.
      Private="false" keeps game assemblies out of bin\ - they belong to the game, not the package.
    -->
    <ItemGroup Condition="$(CI) != 'true'">
      <Reference Include="$(ManagedDirectory)Assembly-CSharp.dll" Publicize="true" Private="false" />
      <Reference Include="$(ManagedDirectory)Unity.Netcode.Runtime.dll" Private="false"/>
      <Reference Include="$(ManagedDirectory)Unity.Collections.dll" Private="false"/>
      <Reference Include="$(ManagedDirectory)Unity.Mathematics.dll" Private="false"/>
    </ItemGroup>

    <!-- Package References - Game Assemblies -->
    <ItemGroup Condition="$(CI) == 'true'">
      <PackageReference Include="LethalCompany.GameLibs.Steam" Version="*-*" Publicize="true" PrivateAssets="all" />
    </ItemGroup>

  <ItemGroup>
    <Reference Include="Coroner"><HintPath>../dlls/Coroner.dll</HintPath></Reference>
    <Reference Include="EmployeeClasses"><HintPath>../dlls/EmployeeClasses.dll</HintPath></Reference>
    <Reference Include="PathfindingLib"><HintPath>../dlls/PathfindingLib.dll</HintPath></Reference>
    <Reference Include="EnhancedMonsters"><HintPath>../dlls/EnhancedMonsters.dll</HintPath></Reference>
  </ItemGroup>

  <Target Name="NetcodePatch" AfterTargets="PostBuildEvent">
    <Exec Command="netcode-patch -uv 2022.3.62 -nv 1.12.0 -tv 1.0.0 &quot;$(TargetPath)&quot; @(ReferencePathWithRefAssemblies->'&quot;%(Identity)&quot;', ' ')" />
  </Target>

  <Target Name="PackThunderstore" DependsOnTargets="NetcodePatch" AfterTargets="PostBuildEvent" Condition="$(Configuration) == 'Release'">
    <Exec Command="dotnet tcli build --config-path &quot;$(ProjectDir)Thunderstore\thunderstore.toml&quot; --package-version $(Version) --package-name $(Product) --package-namespace $(ThunderstoreTeam)" />
  </Target>

  <!--
    NVorbis ships beside the plugin (Thunderstore puts it in lib/NVorbis/), so both files have to
    land in $(TargetDir). $(NuGetPackageRoot) is the machine's own package cache and already ends
    with a separator - it replaces a hardcoded C:\Users\<name>\.nuget\... path that only ever
    worked on one machine. Version comes from $(NVorbisVersion) so this cannot drift from the
    PackageReference above.
  -->
  <Target Name="CopyNVorbis" AfterTargets="Build">
    <PropertyGroup>
      <NVorbisLibDir>$(NuGetPackageRoot)nvorbis/$(NVorbisVersion)/lib/netstandard2.0/</NVorbisLibDir>
    </PropertyGroup>
    <ItemGroup>
      <NVorbisFiles Include="$(NVorbisLibDir)NVorbis.dll" />
      <NVorbisFiles Include="$(NVorbisLibDir)NVorbis.xml" />
    </ItemGroup>
    <Error Condition="!Exists('$(NVorbisLibDir)NVorbis.dll')"
           Text="NVorbis $(NVorbisVersion) not found at $(NVorbisLibDir). Run 'dotnet restore' first; if it still fails, NVorbisVersion no longer matches the restored package." />
    <Copy SourceFiles="@(NVorbisFiles)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>